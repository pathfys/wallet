    "@ton-community/func-js": "0.9.1",
    "@ton/crypto": "3.3.0",
    "@ton/sandbox": "0.27.1",
    "@ton/ton": "15.1.0",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
