# ---------------- PMR Wallet backend ----------------
# Скопируйте в .env, заполните и выполните: chmod 600 .env

# Токен бота из @BotFather (им же проверяется подпись initData Mini App)
BOT_TOKEN=
# Telegram ID администраторов/поддержки через запятую (доступ к «Панели» и арбитражу)
ADMIN_IDS=

# Секреты: сгенерируйте командой `npm run gen:keys`
# ARBITER_SECRET — ключ арбитра эскроу (подписывает решения по апелляциям). Храните офлайн-копию.
ARBITER_SECRET=
# DATA_KEY — ключ AES-256-GCM для шифрования реквизитов в базе
DATA_KEY=

# Сеть TON: сначала проверьте всё на testnet
TON_NETWORK=mainnet
# Ключ toncenter (https://t.me/tonapibot) — без него лимит 1 запрос/с
TONCENTER_API_KEY=
# Кошелёк комиссий — ДОЛЖЕН совпадать с CONFIG.FEE_WALLET в index.html
FEE_WALLET=UQAtqU5yzF4yMzJqqvCSJxH9dgaOr8Mciuikl3ws66scVoaW
# USD₮ jetton master (mainnet)
USDT_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs

# Курс рубля ПМР к доллару для плавающих цен RUB(ПМР) (пусто — только фиксированные цены)
PRB_PER_USD=

# Сеть
HOST=127.0.0.1
PORT=8080
# 1 — сервер за nginx (берёт IP из X-Real-IP). Не включайте без прокси!
TRUST_PROXY=1
# Если фронтенд на другом домене (например, GitHub Pages) — его origin; иначе пусто
ALLOWED_ORIGINS=
# Раздавать фронтенд (index.html, vendor/, icons/) этим же сервером с нужными заголовками
STATIC_DIR=..
DATA_DIR=./data

# Ссылка на Mini App для кнопок в уведомлениях бота: https://t.me/<bot>/<app>
TG_APP_LINK=
# URL самого приложения (index.html) — кнопка «Открыть PMR WALLET» в приветствии и кнопка меню бота
WEBAPP_URL=https://wallet.example.com/

# Как бот получает сообщения (/start, /help): polling — без настройки, webhook — для продакшена, off — выключен
BOT_MODE=polling
# Для BOT_MODE=webhook: адрес строго https://<домен>/api/tg/webhook и секрет (openssl rand -hex 32).
# Telegram присылает секрет в заголовке каждого запроса; без него вебхук отвечает 401.
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# Комиссия P2P с каждой стороны в базисных пунктах: 200 = 2% с покупателя + 2% с продавца (4% за ордер).
# Если поднимаете выше 200 — поднимите и CONFIG.MAX_P2P_FEE_SIDE_BPS в index.html, иначе клиенты откажутся блокировать средства.
P2P_FEE_SIDE_BPS=200
# Потолок комиссии с одной стороны в USD (0 — без потолка)
P2P_FEE_MAX_SIDE_USD=0

# Тайминги P2P (минуты/часы/дни)
ESCROW_LOCK_WINDOW_MIN=15
APPEAL_AFTER_MIN=10
AUTO_APPEAL_HOURS=24
ESCROW_RECLAIM_DAYS=14
LOGIN_MAX_AGE_SEC=86400
SESSION_TTL_SEC=43200
