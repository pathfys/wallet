# Copy to /etc/plwallet.env and `chmod 600` it. Systemd loads this via
# EnvironmentFile= in plwallet.service.

BOT_TOKEN=123456789:AA-your-token-from-BotFather
ADMIN_ID=123456789
WEBAPP_URL=https://pl-wallet.com/pl.html

# Local port the aiohttp app binds to; nginx proxies from api.pl-wallet.com:443.
BOT_HTTP_HOST=127.0.0.1
BOT_HTTP_PORT=8080

# SQLite file lives inside the deploy directory.
DB_PATH=/opt/plwallet/data.db

# Only these origins may call /api/*. Keep tight.
CORS_ORIGINS=https://pl-wallet.com,https://www.pl-wallet.com,null

# initData validity window (seconds). Shorter → tighter replay window.
INIT_MAX_AGE=300
